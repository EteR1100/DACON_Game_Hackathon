.shop-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: flex-end;
    pointer-events: none;
    display: none;
}

.shop-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.84);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
}

.shop-panel {
    width: 100%;
    height: 80%;
    background-color: rgba(2, 3, 10, 0.98);
    border-top-width: 4px;
    border-color: #00ffff;
    padding: 28px 32px;
    translate: 0 100%;
    transition-property: translate;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
    pointer-events: auto;
}

.shop-root--open {
    display: flex;
    pointer-events: auto;
}

.shop-root--open .shop-panel {
    translate: 0 0;
}

.shop-root--open .shop-overlay {
    opacity: 1;
    pointer-events: auto;
}

.shop-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.shop-header-btn {
    width: 120px;
    height: 46px;
    background-color: rgba(255, 0, 110, 0.18);
    border-width: 2px;
    border-color: #ff006e;
    color: #ff006e;
    font-size: 15px;
    -unity-font-style: bold;
}

.shop-header-btn:hover {
    background-color: rgba(255, 0, 110, 0.24);
    border-color: #ffffff;
}

.shop-title-group {
    align-items: center;
}

.shop-kicker {
    color: #39ff14;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.shop-title {
    color: #ffffff;
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #00ffff;
}

.shop-coin-box {
    min-width: 170px;
    background-color: rgba(57, 255, 20, 0.09);
    border-left-width: 3px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: #39ff14;
    padding: 8px 14px;
}

.shop-coin-label {
    color: rgba(255, 255, 255, 0.6);
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.shop-coin-value {
    color: #39ff14;
    font-size: 24px;
    -unity-font-style: bold;
}

.shop-divider {
    height: 2px;
    background-color: rgba(0, 255, 255, 0.35);
    margin-bottom: 24px;
}

.shop-item-scroll {
    flex-grow: 1;
}

.item-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.shop-item-card {
    width: 23%;
    min-height: 220px;
    margin: 1%;
    background-color: rgba(4, 7, 18, 0.92);
    border-left-width: 4px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(0, 255, 255, 0.35);
    padding: 16px;
    align-items: center;
    transition-property: border-color, background-color;
    transition-duration: 0.18s;
}

.shop-item-card:hover {
    border-color: #00ffff;
    background-color: rgba(0, 255, 255, 0.1);
}

.shop-item-card--equipped {
    border-color: #39ff14;
    background-color: rgba(57, 255, 20, 0.07);
}

.item-preview {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    margin-bottom: 15px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.35);
}

.item-name {
    color: #ffffff;
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.item-status {
    color: #39ff14;
    font-size: 14px;
    -unity-font-style: bold;
}

.item-price-box {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
}

.item-price-value {
    color: #39ff14;
    font-size: 16px;
    -unity-font-style: bold;
}

.btn-buy {
    width: 82%;
    height: 40px;
    margin-top: 8px;
    background-color: rgba(0, 136, 255, 0.22);
    border-color: #0088ff;
    border-width: 1px;
    color: #ffffff;
    font-size: 14px;
    -unity-font-style: bold;
}

.btn-buy:hover {
    background-color: rgba(0, 255, 255, 0.26);
    border-color: #00ffff;
}
