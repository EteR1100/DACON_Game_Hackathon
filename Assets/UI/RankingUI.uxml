<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <ui:Style src="project://database/Assets/UI/CyberMainMenuStyle.uss" />
    <ui:Style src="project://database/Assets/UI/RankingUIStyle.uss" />

    <ui:VisualElement class="container ranking-bg">
        <ui:VisualElement class="bg-grid" />
        <ui:VisualElement class="bg-vignette" />
        <ui:VisualElement class="bg-scanlines" />

        <ui:VisualElement class="top-hud">
            <ui:VisualElement class="hud-left">
            </ui:VisualElement>

            <ui:VisualElement class="hud-center">
                <ui:Label text="HALL OF FAME" class="cyber-title ranking-title-text" />
                <ui:Label text="/// HALL OF FAME ///" class="cyber-subtitle ranking-subtitle-text" />
            </ui:VisualElement>

            <ui:VisualElement class="hud-right">
                <ui:Button name="BtnHome" class="btn-home-cyber">
                    <ui:Label text="HOME" class="btn-home-text" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="ranking-tabs">
            <ui:Button name="TabDaily" class="tab-btn" text="DAILY" />
            <ui:Button name="TabWeekly" class="tab-btn" text="WEEKLY" />
            <ui:Button name="TabAll" class="tab-btn tab-active" text="ALL-TIME" />
        </ui:VisualElement>

        <ui:VisualElement class="refresh-area">
            <ui:Label text="LAST UPDATED: JUST NOW" name="LblLastUpdate" class="refresh-text" />
            <ui:Button name="BtnRefresh" class="btn-refresh-cyber">
                <ui:Label text="REFRESH" class="btn-refresh-text" />
            </ui:Button>
        </ui:VisualElement>

        <ui:VisualElement class="ranking-list-area">
            <!-- Error Message Area (Hidden by default) -->
            <ui:VisualElement name="ErrorArea" class="error-overlay" style="display: none;">
                <ui:Label text="&gt; CONNECTION_FAILURE" class="error-title" />
                <ui:Label text="UNABLE TO ESTABLISH CONNECTION WITH THE SERVER." class="error-desc" />
                <ui:Button name="BtnRetry" class="btn-retry-cyber" text="RE-ESTABLISH CONNECTION" />
            </ui:VisualElement>

            <ui:ScrollView class="ranking-scroll">
                <ui:VisualElement name="RankingListContainer" class="list-container">
                    <!-- Dynamic ranking items here -->
                </ui:VisualElement>
            </ui:ScrollView>

            <!-- Sticky My Rank Bar -->
            <ui:VisualElement name="MyRankContainer" class="my-rank-sticky">
                <ui:VisualElement class="rank-left-group">
                    <ui:Label text="#--" name="MyRankNumber" class="rank-number my-rank-accent" />
                    <ui:VisualElement class="rank-avatar my-rank-avatar" />
                    <ui:VisualElement class="rank-info">
                        <ui:Label text="USER" name="MyRankName" class="rank-name-text my-rank-accent" />
                        <ui:Label text="LAST PLAY: ----" name="MyRankDate" class="rank-date-text" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="rank-score-group">
                    <ui:Label text="MY BEST" class="rank-score-caption" />
                    <ui:Label text="0" name="MyRankScore" class="rank-score-text my-rank-accent" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
