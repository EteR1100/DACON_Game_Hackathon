<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <ui:Style src="project://database/Assets/UI/CyberMainMenuStyle.uss" />

    <ui:VisualElement class="container">
        <ui:VisualElement class="bg-grid" />
        <ui:VisualElement class="grid-lines">
            <ui:VisualElement class="grid-line-v v01" />
            <ui:VisualElement class="grid-line-v v02" />
            <ui:VisualElement class="grid-line-v v03" />
            <ui:VisualElement class="grid-line-v v04" />
            <ui:VisualElement class="grid-line-v v05" />
            <ui:VisualElement class="grid-line-v v06" />
            <ui:VisualElement class="grid-line-v v07" />
            <ui:VisualElement class="grid-line-v v08" />
            <ui:VisualElement class="grid-line-v v09" />
            <ui:VisualElement class="grid-line-v v10" />
            <ui:VisualElement class="grid-line-v v11" />
            <ui:VisualElement class="grid-line-v v12" />
            <ui:VisualElement class="grid-line-v v13" />
            <ui:VisualElement class="grid-line-v v14" />
            <ui:VisualElement class="grid-line-v v15" />
            <ui:VisualElement class="grid-line-h h01" />
            <ui:VisualElement class="grid-line-h h02" />
            <ui:VisualElement class="grid-line-h h03" />
            <ui:VisualElement class="grid-line-h h04" />
            <ui:VisualElement class="grid-line-h h05" />
            <ui:VisualElement class="grid-line-h h06" />
            <ui:VisualElement class="grid-line-h h07" />
            <ui:VisualElement class="grid-line-h h08" />
            <ui:VisualElement class="grid-line-h h09" />
        </ui:VisualElement>
        <ui:VisualElement class="bg-vignette" />
        <ui:VisualElement class="bg-scanlines" />

        <ui:VisualElement class="hud-top">
            <ui:VisualElement class="hud-group">
                <ui:VisualElement class="hud-box">
                    <ui:Label text="USER" class="hud-label" />
                    <ui:Label text="UNKNOWN" class="hud-value" name="LblNickname" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-box">
                    <ui:Label text="SCORE" class="hud-label" />
                    <ui:Label text="0" class="hud-value" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-box">
                    <ui:Label text="BEST" class="hud-label" />
                    <ui:Label text="0" class="hud-value" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-box volume-box">
                    <ui:Label text="VOL" class="hud-label" />
                    <ui:Slider name="SliderVolume" low-value="0" high-value="1" value="0.5" class="hud-slider" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="hud-group">
                <ui:VisualElement class="hud-box hud-accent">
                    <ui:Label text="DATA PACKETS" class="hud-label-accent" />
                    <ui:Label text="0" class="hud-value-accent" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="main-stage">
            <ui:VisualElement class="title-area">
                <ui:VisualElement class="title-stack">
                    <ui:Label text="BALATITA" class="cyber-title cyber-title-glow-wide" />
                    <ui:Label text="BALATITA" class="cyber-title cyber-title-glow" />
                    <ui:Label text="BALATITA" class="cyber-title cyber-title-main" />
                </ui:VisualElement>
                <ui:Label text="/// ANTI-GRAVITY RUNNER ///" class="cyber-subtitle" />
            </ui:VisualElement>

            <ui:VisualElement class="terminal-box">
                <ui:Label text="SYSTEM.INFO: 조작 방법 안내" class="terminal-header" />
                <ui:VisualElement class="terminal-content">
                    <ui:Label text="- 시스템 접근 대기 중..." class="terminal-text" />
                    <ui:Label text="- 클릭 / 스페이스 : 중력 반전" class="terminal-highlight" />
                    <ui:Label text="- 장애물을 피하고 데이터를 수집하라." class="terminal-text" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="action-panel">
                <ui:Button text="&gt; SYSTEM START &lt;" class="btn-start" name="BtnStart" />

                <ui:VisualElement class="sub-actions">
                    <ui:Button text="[ MODULE: SHOP ]" class="btn-shop" name="BtnShop" />
                    <ui:Button text="[ MODULE: RANKING ]" class="btn-rank" name="BtnRank" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="corner corner-top-left" />
        <ui:VisualElement class="corner corner-top-right" />
        <ui:VisualElement class="corner corner-bottom-left" />
        <ui:VisualElement class="corner corner-bottom-right" />

        <ui:VisualElement class="popup-overlay" name="NicknamePopup">
            <ui:VisualElement class="bg-grid popup-bg-grid" />
            <ui:VisualElement class="grid-lines">
                <ui:VisualElement class="grid-line-v v01" />
                <ui:VisualElement class="grid-line-v v02" />
                <ui:VisualElement class="grid-line-v v03" />
                <ui:VisualElement class="grid-line-v v04" />
                <ui:VisualElement class="grid-line-v v05" />
                <ui:VisualElement class="grid-line-v v06" />
                <ui:VisualElement class="grid-line-v v07" />
                <ui:VisualElement class="grid-line-v v08" />
                <ui:VisualElement class="grid-line-v v09" />
                <ui:VisualElement class="grid-line-v v10" />
                <ui:VisualElement class="grid-line-v v11" />
                <ui:VisualElement class="grid-line-v v12" />
                <ui:VisualElement class="grid-line-v v13" />
                <ui:VisualElement class="grid-line-v v14" />
                <ui:VisualElement class="grid-line-v v15" />
                <ui:VisualElement class="grid-line-h h01" />
                <ui:VisualElement class="grid-line-h h02" />
                <ui:VisualElement class="grid-line-h h03" />
                <ui:VisualElement class="grid-line-h h04" />
                <ui:VisualElement class="grid-line-h h05" />
                <ui:VisualElement class="grid-line-h h06" />
                <ui:VisualElement class="grid-line-h h07" />
                <ui:VisualElement class="grid-line-h h08" />
                <ui:VisualElement class="grid-line-h h09" />
            </ui:VisualElement>
            <ui:VisualElement class="bg-scanlines" />
            <ui:VisualElement class="popup-corner popup-corner-left-top" />
            <ui:VisualElement class="popup-corner popup-corner-right-top" />
            <ui:VisualElement class="popup-corner popup-corner-left-bottom" />
            <ui:VisualElement class="popup-corner popup-corner-right-bottom" />

            <ui:VisualElement class="login-stage">
                <ui:VisualElement class="boot-log">
                    <ui:Label text="&gt;&gt;&gt; SYSTEM INITIALIZING" class="boot-line" />
                    <ui:Label text="&gt;&gt;&gt; LOADING GRAVITY ENGINE... [OK]" class="boot-line" />
                    <ui:Label text="&gt;&gt;&gt; ESTABLISHING CONNECTION..." class="boot-line" />
                </ui:VisualElement>

                <ui:VisualElement class="popup-title-area">
                    <ui:VisualElement class="title-stack popup-title-stack">
                        <ui:Label text="BALATITA" class="cyber-title cyber-title-glow-wide popup-cyber-title" />
                        <ui:Label text="BALATITA" class="cyber-title cyber-title-glow popup-cyber-title" />
                        <ui:Label text="BALATITA" class="cyber-title cyber-title-main popup-cyber-title" />
                    </ui:VisualElement>
                    <ui:Label text="/// ANTI-GRAVITY RUNNER ///" class="cyber-subtitle popup-subtitle" />
                </ui:VisualElement>

                <ui:VisualElement class="popup-box">
                    <ui:Label text="&gt; USER IDENTIFICATION REQUIRED" class="popup-kicker" />
                    <ui:Label text="시스템 접근을 위해 사용자 이름을 입력하세요" class="popup-desc" />
                    <ui:Label text="[ NICKNAME ]" class="popup-field-label" />
                    <ui:TextField name="InputNickname" class="popup-input" text="" />
                    <ui:Label text="2-12자 / 0/12" name="NicknameCounter" class="popup-counter" />
                    <ui:Button text="&gt;&gt; ACCESS SYSTEM &lt;&lt;" name="BtnConfirmNickname" class="popup-btn" />
                    <ui:VisualElement class="popup-divider" />
                    <ui:Label text="TIP: 닉네임은 랭킹에 표시됩니다" class="popup-tip" />
                </ui:VisualElement>

                <ui:Label text="BALATITA v1.0.0 // ANTI-GRAVITY SYSTEM ONLINE" class="popup-footer" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
