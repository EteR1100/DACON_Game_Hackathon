<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <ui:Style src="project://database/Assets/UI/CyberMainMenuStyle.uss" />

    <ui:VisualElement class="container">
        <ui:VisualElement class="bg-grid" />
        <ui:VisualElement class="bg-vignette" />
        <ui:VisualElement class="bg-scanlines" />

        <ui:VisualElement class="hud-top">
            <ui:VisualElement class="hud-group">
                <ui:VisualElement class="hud-box">
                    <ui:Label text="USER" class="hud-label" />
                    <ui:Label text="UNKNOWN" class="hud-value" name="LblNickname" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-box">
                    <ui:Label text="SCORE" class="hud-label" />
                    <ui:Label text="0" class="hud-value" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-box">
                    <ui:Label text="BEST" class="hud-label" />
                    <ui:Label text="0" class="hud-value" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="hud-group">
                <ui:VisualElement class="hud-box hud-accent">
                    <ui:Label text="DATA PACKETS" class="hud-label-accent" />
                    <ui:Label text="0" class="hud-value-accent" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="main-stage">
            <ui:VisualElement class="title-area">
                <ui:Label text="BALATITA" class="cyber-title" />
                <ui:Label text="ANTI-GRAVITY RUNNER" class="cyber-subtitle" />
            </ui:VisualElement>

            <ui:VisualElement class="status-strip">
                <ui:Label text="SYSTEM ONLINE" class="strip-label" />
                <ui:Label text="READY TO FLIP GRAVITY" class="strip-value" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="bottom-area">
            <ui:VisualElement class="terminal-box">
                <ui:Label text="SYSTEM.INFO / CONTROLS" class="terminal-header" />
                <ui:VisualElement class="terminal-content">
                    <ui:Label text="System access standing by..." class="terminal-text" />
                    <ui:Label text="Click / Space : gravity flip" class="terminal-highlight" />
                    <ui:Label text="Avoid obstacles and collect data." class="terminal-text" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="action-panel">
                <ui:Button text="SYSTEM START" class="btn-start" name="BtnStart" />

                <ui:VisualElement class="sub-actions">
                    <ui:Button text="SHOP" class="btn-shop" name="BtnShop" />
                    <ui:Button text="RANKING" class="btn-rank" name="BtnRank" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="popup-overlay" name="NicknamePopup">
            <ui:VisualElement class="popup-box">
                <ui:Label text="SYSTEM LOGIN" class="popup-kicker" />
                <ui:Label text="ENTER IDENTIFIER" class="popup-title" />
                <ui:TextField name="InputNickname" class="popup-input" text="" />
                <ui:Button text="CONFIRM" name="BtnConfirmNickname" class="popup-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
