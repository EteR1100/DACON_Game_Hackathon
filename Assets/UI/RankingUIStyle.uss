.ranking-bg {
    background-color: #02030a;
}

.top-hud {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
}

.hud-left,
.hud-right {
    flex-direction: column;
    min-width: 190px;
}

.hud-right {
    align-items: flex-end;
}

.hud-center {
    align-items: center;
    flex-grow: 1;
}

.mini-hud {
    margin-bottom: 12px;
}

.ranking-title-text {
    font-size: 60px;
    margin-bottom: 4px;
    -unity-text-outline-width: 2px;
}

.ranking-subtitle-text {
    font-size: 18px;
    padding: 4px 14px;
}

.btn-home-cyber {
    height: 52px;
    min-width: 132px;
    background-color: rgba(4, 7, 18, 0.9);
    border-width: 2px;
    border-color: #ff006e;
    padding: 8px 22px;
    margin-bottom: 12px;
}

.btn-home-cyber:hover {
    background-color: rgba(255, 0, 110, 0.12);
}

.btn-home-text {
    color: #ff006e;
    font-size: 18px;
    -unity-font-style: bold;
}

.ranking-list-area {
    flex-grow: 1;
    align-items: center;
    margin-top: 8px;
}

.ranking-scroll {
    width: 860px;
    flex-grow: 1;
}

.list-container {
    padding: 4px 10px 20px 4px;
}

.rank-card {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 116px;
    background-color: rgba(4, 7, 18, 0.82);
    border-width: 2px;
    border-color: #0080ff;
    margin-bottom: 16px;
    padding: 22px 28px;
}

.rank-card:hover {
    background-color: rgba(0, 255, 255, 0.08);
}

.rank-card-alt {
    background-color: rgba(2, 3, 10, 0.82);
}

.card-gold {
    border-color: #39ff14;
}

.card-silver {
    border-color: #00ffff;
}

.card-bronze {
    border-color: #ff006e;
}

.rank-left-group {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.rank-number {
    width: 72px;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.rank-avatar {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    margin-right: 22px;
    border-width: 2px;
    border-color: #0080ff;
    background-color: rgba(0, 128, 255, 0.08);
}

.avatar-rainbow {
    border-color: #39ff14;
    background-color: rgba(57, 255, 20, 0.12);
}

.avatar-yellow {
    border-color: #00ffff;
    background-color: rgba(0, 255, 255, 0.12);
}

.avatar-purple {
    border-color: #ff006e;
    background-color: rgba(255, 0, 110, 0.12);
}

.avatar-cyan {
    border-color: #0080ff;
    background-color: rgba(0, 128, 255, 0.12);
}

.rank-info {
    flex-direction: column;
}

.rank-name-text {
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.rank-date-text {
    color: rgba(255, 255, 255, 0.4);
    font-size: 14px;
}

.rank-score-group {
    align-items: flex-end;
    min-width: 190px;
}

.rank-score-caption {
    color: rgba(255, 255, 255, 0.6);
    font-size: 13px;
    margin-bottom: 4px;
}

.rank-score-text {
    font-size: 34px;
    -unity-font-style: bold;
}

.rank-coin-text {
    color: #39ff14;
    font-size: 14px;
    margin-top: 6px;
}

.rank-tone-gold {
    color: #39ff14;
}

.rank-tone-silver {
    color: #00ffff;
}

.rank-tone-bronze {
    color: #ff006e;
}

.rank-tone-blue {
    color: #0080ff;
}
